# All values are public (they ship in the browser bundle). Never put a secret here.
# Identity Server that issues tokens (NOAHIdentityServer)
VITE_OIDC_AUTHORITY=https://identity-dev.nuvol9.com
# Public PKCE client (NOAHIdentityServer migration 20261112_0130_ConfigureAffiliatePortalClient)
VITE_OIDC_CLIENT_ID=affiliate-portal
# Solasta Lighting DealerTenant proxy, sent as acr_values=tenant:<proxy> so the login page pins the tenant
VITE_OIDC_TENANT=SOLA:3176D:198205F5-C1E1-4D80-8BFB-C7C6688BFDB6
# Solasta API base URL, no trailing slash
VITE_API_BASE_URL=https://solasta-api-dev.nuvol9.com
# Shown to affiliates who need help
VITE_SUPPORT_EMAIL=affiliates@mysolasta.com
